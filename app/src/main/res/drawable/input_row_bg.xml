<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><gradient android:angle="270" android:startColor="#6C21364D" android:endColor="#8C16243B" />
            <stroke android:width="0.75dp" android:color="#E6F2F8FF" /><corners android:radius="13dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80526889" android:endColor="#94304462" />
            <stroke android:width="1dp" android:color="#DDECF7FF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
