<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary lines of a focused list row (package, signing key): dark enough to read on the white
     focused background at 10sp; unfocused the same as pill_text_dim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#73FFFFFF" />
    <item android:state_focused="true" android:color="#E6FFFFFF" />
    <item android:color="#A6FFFFFF" />
</selector>
