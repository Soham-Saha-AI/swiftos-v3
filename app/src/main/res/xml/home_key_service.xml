<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: HOME timing needs no window events or content access. Key filtering depends on
     flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on accessibilityEventTypes. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_key_description" />
